# Copy to jenkins/.env and fill in. jenkins/.env is gitignored.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Docker Hub username and an access token (Account settings > Personal access tokens).
DOCKERHUB_USER=paradox73
DOCKERHUB_TOKEN=

# Gmail address and a 16-character app password (Google Account > Security > App passwords).
SMTP_USER=
SMTP_PASSWORD=
