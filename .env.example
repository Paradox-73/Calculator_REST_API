# Copy this file to ".env" and change the values.
# The file ".env" is not committed, because it can hold local settings.
# Never put a password or a token in this file.

# The Docker Hub repository of the image.
IMAGE_NAME=paradox73/calculator-app

# The image tag. Jenkins sets this value to the build number.
IMAGE_TAG=latest

# The host port of the Nginx proxy. Jenkins uses port 8080.
HOST_PORT=8081

# The active Spring profile.
SPRING_PROFILES_ACTIVE=docker
